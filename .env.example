# SetoffIQ needs no configuration to run.
#
# There are no API keys anywhere in this project. Every data source it uses is
# open and keyless, which is what keeps the app free to run and free to use.
# The two variables below only affect the optional local explanation model,
# which is off by default and is not used by the published site.

# Where a local Ollama instance is listening.
# VITE_OLLAMA_URL=http://localhost:11434

# Which local model to ask for the explanation wording.
# VITE_OLLAMA_MODEL=llama3.2
